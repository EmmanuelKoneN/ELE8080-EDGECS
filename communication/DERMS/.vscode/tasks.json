
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build EDGECS DERMS (CMake)",
            "type": "shell",
            "command": "/usr/bin/cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--parallel",
                "4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build the complete EDGECS DERMS project using CMake"
        }
    ]
}
