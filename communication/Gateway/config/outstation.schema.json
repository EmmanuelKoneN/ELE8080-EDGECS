{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgecs.local/schemas/outstation-v1.schema.json",
  "title": "EDGECS - Configuration DER / Gateway schema_version=1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "name",
    "der_type",
    "dnp3",
    "points"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "der_type": {
      "type": "string",
      "minLength": 1
    },
    "dnp3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "master_address",
        "outstation_address"
      ],
      "properties": {
        "host": {
          "type": "string",
          "format": "ipv4"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "master_address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65519
        },
        "outstation_address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65519
        }
      }
    },
    "mqtt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "type": "string",
          "format": "ipv4"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "master_api_host": {
      "type": "string",
      "format": "ipv4"
    },
    "master_api_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "direction",
          "dnp3_type",
          "index",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 1
          },
          "alias": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "command",
              "telemetry"
            ]
          },
          "dnp3_type": {
            "enum": [
              "AO",
              "BO",
              "AI",
              "BI"
            ]
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "unit": {
            "type": "string"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "initial": {
            "type": [
              "number",
              "boolean"
            ]
          },
          "feedback_point": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "dnp3_type": {
                  "const": "AO"
                }
              },
              "required": [
                "dnp3_type"
              ]
            },
            "then": {
              "properties": {
                "direction": {
                  "const": "command"
                }
              },
              "required": [
                "min",
                "max"
              ],
              "not": {
                "required": [
                  "initial"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "dnp3_type": {
                  "const": "BO"
                }
              },
              "required": [
                "dnp3_type"
              ]
            },
            "then": {
              "properties": {
                "direction": {
                  "const": "command"
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "initial"
                    ]
                  },
                  {
                    "required": [
                      "min"
                    ]
                  },
                  {
                    "required": [
                      "max"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "dnp3_type": {
                  "const": "AI"
                }
              },
              "required": [
                "dnp3_type"
              ]
            },
            "then": {
              "properties": {
                "direction": {
                  "const": "telemetry"
                },
                "initial": {
                  "type": "number"
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "feedback_point"
                    ]
                  },
                  {
                    "required": [
                      "min"
                    ]
                  },
                  {
                    "required": [
                      "max"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "dnp3_type": {
                  "const": "BI"
                }
              },
              "required": [
                "dnp3_type"
              ]
            },
            "then": {
              "properties": {
                "direction": {
                  "const": "telemetry"
                },
                "initial": {
                  "type": "boolean"
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "feedback_point"
                    ]
                  },
                  {
                    "required": [
                      "min"
                    ]
                  },
                  {
                    "required": [
                      "max"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
