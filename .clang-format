# Style C/C++ du projet EDGECS, utilisé seulement si une partie est écrite en C++
# (par exemple la couche DNP3). Python est formaté par Ruff.
# Pour reprendre exactement le style du cours, remplacer ce fichier par le .clang-format du labo.
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: WithoutElse
